# Confusion Matrix Layer Configuration
# Copy to .env and configure for your environment

# ============================================
# Rust Binary Configuration
# ============================================

# Rasterization DPI (higher = better quality, slower)
NOISE_LAYER_DPI=200

# Perturbation epsilon (lower = imperceptible, higher = robust)
NOISE_LAYER_EPSILON=0.003

# JPEG compression quality (1-100)
NOISE_LAYER_JPEG_QUALITY=95

# Custom VGG16 weights path (optional, auto-downloads if not set)
# NOISE_LAYER_WEIGHTS_PATH=/path/to/vgg16.ot

# ============================================
# System Libraries
# ============================================

# Pdfium library path (required)
PDFIUM_DYNAMIC_LIB_PATH=/path/to/binaries/libpdfium.so

# LibTorch installation directory (optional if installed system-wide)
# LIBTORCH=/path/to/libtorch

# Library search paths (Linux/macOS)
# LD_LIBRARY_PATH=/path/to/libtorch/lib:/usr/local/lib
# DYLD_LIBRARY_PATH=/path/to/libtorch/lib:/usr/local/lib  # macOS only

# ============================================
# AWS Configuration (Production)
# ============================================

# AWS region
AWS_REGION=us-east-1

# S3 buckets for document storage
AWS_S3_BUCKET=solvance-documents
AWS_S3_BUCKET_PROCESSED=solvance-protected

# Lambda function name (auto-detected if running in Lambda)
# AWS_LAMBDA_FUNCTION_NAME=confusion-matrix-watermark

# ============================================
# Development Settings
# ============================================

# Node environment
NODE_ENV=development

# Processing mode: "cli" | "lambda" | "ecs"
# PROCESSING_MODE=cli
